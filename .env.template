# Polya — environment template
# Copy to .env.local for Next.js development. Never commit real values.

# Canonical site origin. Used for auth callbacks and as the base for all SEO
# URLs (canonicals, sitemap, Open Graph). Set in Vercel prod; the code falls
# back to https://askpolya.com when unset.
NEXT_PUBLIC_SITE_URL=https://askpolya.com

# Search-engine ownership verification (optional — the meta tags are emitted
# only when these are set; tokens come from Search Console / Bing Webmaster).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Shared Canvascope Supabase project ("Canvascope Database")
SUPABASE_PROJECT_REF=vcadcdgnwxjlgaoqktkd
NEXT_PUBLIC_SUPABASE_URL=https://vcadcdgnwxjlgaoqktkd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# ------------------------------------------------------------------
# Edge-function env ONLY (set via `supabase secrets set` / dashboard;
# never place these in Next.js/Vercel env):
#   ANTHROPIC_API_KEY          — already present in the shared project
#   GEMINI_API_KEY             — already present in the shared project
#   SUPABASE_SERVICE_ROLE_KEY  — auto-injected into edge functions
#   POLYA_TOKEN_KEY            — 32 bytes base64 (openssl rand -base64 32);
#                                encrypts Canvas access tokens at rest
#   POLYA_ALLOW_INSECURE_CANVAS — "1" ONLY in local supabase/functions/.env for
#                                the mock-Canvas integration test; never remote
#
# Node-fallback parsing route only (activate only if the Deno PDF
# pipeline is abandoned per docs/ARCHITECTURE.md):
#   SUPABASE_SERVICE_ROLE_KEY
# ------------------------------------------------------------------
