# Polya on iMessage. Copy to .env.local for `eve dev`; set the same names as encrypted
# environment variables in the Vercel project. Never commit real values.

# Claude, called directly (not through the AI Gateway).
ANTHROPIC_API_KEY=

# Photon project for Polya's iMessage number (not the scope-ops project).
IMESSAGE_PROJECT_ID=
IMESSAGE_PROJECT_SECRET=
# Signing secret of the Photon webhook pointed at https://<deployment>/eve/v1/photon
IMESSAGE_WEBHOOK_SECRET=

# Shared Scope Supabase project. The service-role key bypasses RLS; the agent scopes every
# query to the linked student itself.
POLYA_SUPABASE_URL=
POLYA_SUPABASE_SERVICE_ROLE_KEY=

# Polya web app: link pages (/connect/imessage) and "keep studying at ..." copy.
POLYA_APP_URL=https://askpolya.com

# Bearer secret for POST /polya/check-ins/run (manual or external-cron check-in trigger).
POLYA_CHECKINS_SECRET=

# Bearer secret for POST /polya/gradescope/connect, sent by the askpolya.com connect page's server.
# At least 32 characters; set the same value in the web app.
POLYA_CONNECT_SECRET=

# Only if course search embeds queries itself.
GEMINI_API_KEY=

# Replies per student per UTC day before Polya pauses until the reset. Default 60.
POLYA_IMESSAGE_DAILY_REPLY_CAP=60

# Seals stored Gradescope sessions/passwords (AES-256-GCM). 32 random bytes, base64:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Changing it makes every stored Gradescope connection unreadable (students reconnect).
GRADESCOPE_SECRET_KEY=...
